  "item": [
    {
      "name": "00. Auth (마스터 관리자 로그인 - 게이트웨이 경유)",
      "description": "부트스트랩용 MASTER 계정(master01 / Master1234!)으로 로그인해서 accessToken을 컬렉션 변수에 저장. 이 토큰이 있어야 게이트웨이를 거치는 나머지 모든 요청(anyExchange().authenticated())이 401 없이 통과함. 이 계정은 DB에 SQL로 직접 넣은 계정이라 회원가입 API로는 재현이 안 됨 - MASTER는 정책상 회원가입으로 생성 불가.",
      "item": [
        {
          "name": "01 로그인 (master01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json.data.accessToken.replace(/^Bearer\\s+/, \"\");",
                  "pm.collectionVariables.set(\"accessToken\", token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"master01\",\n  \"password\": \"Master1234!\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/login",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
